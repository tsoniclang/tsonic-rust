{
  "name": "@tsonic/target-rust",
  "version": "0.0.1",
  "description": "Rust target pack for Tsonic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./provider": "./dist/public/provider.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@tsonic/js-source-profile": "0.0.1",
    "@tsonic/source-core": "0.0.1",
    "@tsonic/target-api": "0.0.1",
    "@tsonic/tsts": "0.0.0",
    "@tsonic/rust-runtime": "0.0.1",
    "@tsonic/rust-js": "0.0.1"
  },
  "devDependencies": {
    "@tsonic/js-source-profile": "file:../tsonic/packages/js-source-profile",
    "@tsonic/source-core": "file:../tsonic/packages/source-core",
    "@tsonic/target-api": "file:../tsonic/packages/target-api",
    "@tsonic/tsts": "file:../tsonic/packages/tsts",
    "@tsonic/rust-runtime": "file:../rust-runtime",
    "@tsonic/rust-js": "file:../rust-js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "tsonic": {
    "kind": "plugin",
    "contractVersion": 1,
    "entry": "."
  }
}
