{
  "name": "@tsonic/target-rust",
  "version": "0.0.1",
  "description": "Rust target pack for Tsonic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "runtimes"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "npm run build && node --test test/*.test.mjs test/architecture/*.test.mjs",
    "pretest": "rm -rf .temp/installed && node -e \"import('./test/helpers/rust-session.mjs').then(m => m.buildInstalledLayout())\""
  },
  "peerDependencies": {
    "@tsonic/source-core": "0.0.1",
    "@tsonic/target-api": "0.0.1",
    "@tsonic/tsts": "0.0.0"
  },
  "devDependencies": {
    "@tsonic/source-core": "file:../tsonic/packages/source-core",
    "@tsonic/target-api": "file:../tsonic/packages/target-api",
    "@tsonic/tsts": "file:../tsonic/packages/tsts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "tsonic": {
    "kind": "plugin",
    "contractVersion": 1,
    "entry": "."
  }
}